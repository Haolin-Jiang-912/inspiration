/* pages/index/index.wxss · Dark Editorial */

.page {
  padding-bottom: 220rpx;
}

/* ── Hero ── */
.hero {
  background: #1C1C1E;
  padding: 60rpx 48rpx 56rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-quote {
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
  color: #8E8E93;
  margin-bottom: 28rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.03em;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
}

.sub-line {
  width: 48rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2rpx;
  margin-right: 16rpx;
}

.sub-text {
  font-size: 23rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
  color: #6C6C70;
}

/* ── 主体 ── */
.section {
  padding: 32rpx 0 0;
}

.desc {
  font-size: 28rpx;
  color: #D1D1D6;
  line-height: 1.72;
  letter-spacing: -0.01em;
}

.desc.tip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  font-size: 25rpx;
  color: #AEAEB2;
}

/* ── 数据指标 ── */
.meta-row {
  display: flex;
  margin-top: 36rpx;
  padding: 8rpx 0;
}

.meta-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
}

.meta-item:last-child {
  border-right: none;
}

.meta-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.03em;
}

.meta-label {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

/* ── 评分逻辑 ── */
.score-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.score-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.score-text {
  font-size: 26rpx;
  color: #D1D1D6;
  line-height: 1.65;
  flex: 1;
}

.score-strong {
  font-weight: 600;
  color: #FFFFFF;
}

/* ── 维度一览 ── */
.dim-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dim-chip {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
  padding: 12rpx 24rpx 12rpx 8rpx;
}

.dim-num {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #0A84FF;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dim-name {
  font-size: 25rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ── 免责 ── */
.disclaimer {
  font-size: 22rpx;
  color: #6C6C70;
  text-align: center;
  line-height: 1.7;
  padding: 8rpx 48rpx 0;
}

/* ── 底部 ── */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(26, 26, 28, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  gap: 20rpx;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.footer .btn-primary {
  flex: 1.4;
}

.footer .btn-ghost {
  flex: 1;
}
