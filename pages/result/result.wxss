/* pages/result/result.wxss · Dark Editorial */

.page {
  padding-bottom: 80rpx;
  background: #0A0A0C;
}

/* ── 顶部总分 ── */
.hero {
  background: #1C1C1E;
  padding: 56rpx 48rpx 56rpx;
  border-radius: 0 0 36rpx 36rpx;
  text-align: center;
}

.hero-accent {
  width: 48rpx;
  height: 6rpx;
  border-radius: 999rpx;
  margin: 0 auto 24rpx;
}

.hero-label {
  font-size: 26rpx;
  color: #8E8E93;
  font-weight: 400;
}

.hero-score {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 4rpx;
  color: #FFFFFF;
  letter-spacing: -0.04em;
}

.hero-percent {
  font-size: 48rpx;
  font-weight: 600;
  margin-left: 4rpx;
  color: #8E8E93;
}

.hero-sub {
  font-size: 24rpx;
  color: #6C6C70;
  margin-top: 4rpx;
}

/* ── 主体 ── */
.page > .card {
  margin: 24rpx 32rpx;
}

/* ── 雷达图 ── */
.radar-card {
  text-align: center;
}

.radar-canvas {
  width: 300px;
  height: 300px;
  margin: 12rpx auto 0;
  display: block;
}

/* ── 画像卡 ── */
.profile-head {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  line-height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.02em;
}

.profile-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #AEAEB2;
}

.profile-section {
  margin-bottom: 40rpx;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-bottom: 12rpx;
  letter-spacing: 0.02em;
}

.section-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.72;
  letter-spacing: -0.01em;
}

.blindspot-label {
  color: #FF453A;
}

.blindspot-text {
  color: #AEAEB2;
}

/* ── 常见表现 ── */
.behavior-list {
  padding-left: 0;
}

.behavior-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.behavior-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.behavior-text {
  flex: 1;
  font-size: 27rpx;
  color: #D1D1D6;
  line-height: 1.65;
}

/* ── 维度详情 ── */
.dim-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.dim-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dim-item:first-child {
  padding-top: 0;
}

.dim-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.dim-title {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 16rpx;
}

.dim-icon {
  margin-right: 12rpx;
}

.dim-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}

.dim-score {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.dim-points {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.02em;
}

.dim-max {
  font-size: 22rpx;
  color: #6C6C70;
  margin-right: 12rpx;
}

.dim-bar-track {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.dim-rate {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 10rpx;
  font-weight: 500;
}

.dim-desc {
  font-size: 25rpx;
  color: #AEAEB2;
  line-height: 1.7;
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

/* ── 操作 ── */
.actions {
  margin: 48rpx 32rpx 0;
  display: flex;
  gap: 20rpx;
}

.actions .btn-primary {
  flex: 1;
}

.actions .btn-ghost {
  flex: 1;
}

.btn-card-wrap {
  margin: 20rpx 32rpx 0;
}

.btn-card {
  text-align: center;
  padding: 26rpx 0;
  border-radius: 52rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.12);
  letter-spacing: 0.01em;
}

.btn-card:active {
  opacity: 0.7;
}

.disclaimer {
  font-size: 22rpx;
  color: #6C6C70;
  text-align: center;
  margin-top: 32rpx;
  padding: 0 48rpx;
  line-height: 1.7;
}

/* ── 代表人物卡 ── */
.figure-section {
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.figure-label {
  color: #8E8E93;
}

.figure-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.figure-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  line-height: 64rpx;
  flex-shrink: 0;
}

.figure-info {
  flex: 1;
}

.figure-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.figure-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.02em;
}

.figure-name-en {
  font-size: 22rpx;
  color: #6C6C70;
}

.figure-title {
  font-size: 24rpx;
  color: #0A84FF;
  margin-top: 4rpx;
  font-weight: 500;
}

.figure-bio {
  font-size: 25rpx;
  color: #AEAEB2;
  line-height: 1.65;
  margin-top: 10rpx;
}

.figure-match {
  font-size: 26rpx;
  color: #D1D1D6;
  line-height: 1.85;
  margin-top: 28rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid rgba(255, 255, 255, 0.15);
}

/* ── 推荐歌曲 · 大封面质感 ── */
.song-section {
  margin-top: 48rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.song-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-bottom: 28rpx;
  letter-spacing: 0.04em;
}

.song-card {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.song-cover-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.song-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 700;
  text-align: center;
  line-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.song-cover-text {
  color: rgba(255, 255, 255, 0.95);
  font-size: 56rpx;
  font-weight: 700;
}

.song-info {
  text-align: center;
}

.song-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.02em;
  line-height: 1.3;
}

.song-artist {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 8rpx;
  font-weight: 500;
}

.song-lyric {
  font-size: 28rpx;
  color: #AEAEB2;
  margin-top: 24rpx;
  line-height: 1.8;
  font-style: italic;
  letter-spacing: 0.02em;
  text-align: center;
  padding: 0 24rpx;
}

/* ── 离屏画布 ── */
.card-canvas-offscreen {
  width: 600px;
  height: 1240px;
  position: fixed;
  left: -9999px;
  top: 0;
}

/* ── 卡片预览弹层 ── */
.card-preview {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
}

.card-preview-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.card-preview-box {
  position: relative;
  z-index: 1;
  width: 85%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-preview-img {
  width: 100%;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.4);
}

.card-preview-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.card-preview-actions .btn-primary {
  flex: 1;
  background: #FFFFFF;
  color: #0A0A0C;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 52rpx;
  padding: 26rpx 0;
  line-height: 1.2;
  border: none;
  letter-spacing: 0.01em;
  text-align: center;
}

.card-preview-actions .btn-share {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 52rpx;
  padding: 26rpx 0;
  line-height: 1.2;
  border: none;
  letter-spacing: 0.01em;
}

.card-preview-actions .btn-share::after {
  border: none;
}

.card-preview-close {
  margin-top: 24rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  width: 100%;
  font-weight: 500;
  letter-spacing: 0.02em;
}
